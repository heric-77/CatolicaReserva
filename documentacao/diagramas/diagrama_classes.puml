@startuml Diagrama_Classes
skinparam handwritten false
skinparam class {
    BackgroundColor #FFFFFF
    ArrowColor #1168BD
    BorderColor #1168BD
}
title Diagrama de Classes | Domínio de Reserva (CatólicaReserva - Node.js)

class ReservaController {
    - reservaService : ReservaService
    + criar(req, res)
    + cancelar(req, res)
    + listarMinhas(req, res)
    + listarTodas(req, res)
}

class ReservaService {
    - reservaRepository : ReservaRepository
    - regrasDeReserva : RegraReserva[]
    - regrasDeEdicao : RegraAlteracao[]
    - regrasDeCancelamento : RegraAlteracao[]
    + criar(dadosReserva) : Reserva
    + cancelar(id, usuario) : Reserva
    + listarMinhas(usuarioId) : Reserva[]
    + listarTodas() : Reserva[]
}

interface ReservaRepository <<contrato>> {
    + salvar(reserva) : Reserva
    + buscarPorId(id) : Reserva
    + listarPorUsuario(usuarioId) : Reserva[]
    + listarTodas() : Reserva[]
    + atualizarStatus(id, status) : Reserva
}

interface AgendaDeReservas <<contrato>> {
    + buscarAtivasPorSalaEData(salaId, data) : Reserva[]
}

interface SalaRepository <<contrato>> {
    + listar() : Sala[]
    + buscarPorId(id) : Sala
    + salvar(sala) : Sala
}

interface RegraReserva <<contrato>> {
    + validar(reserva)
}

interface RegraAlteracao <<contrato>> {
    + validar(reserva, usuario)
}

class CamposObrigatorios
class HorarioValido
class SalaDeveExistir
class SemConflitoDeHorario
class ApenasDonoOuAdmin

class MySqlReservaRepository
class MySqlSalaRepository

class Reserva {
    - id : Number
    - usuarioId : Number
    - salaId : Number
    - data : Date
    - horaInicio : String
    - horaFim : String
    - status : String
    + sobrepoe(outra) : Boolean
    + pertenceA(usuarioId) : Boolean
    + cancelar()
}

class Usuario {
    - id : Number
    - nome : String
    - email : String
    - senhaHash : String
    - tipo : String
    + ehAdmin() : Boolean
    + {static} validarCadastro(dados)
}

class Sala {
    - id : Number
    - nome : String
    - tipo : String
    - capacidade : Number
    - recursos : String
    + {static} criar(dados) : Sala
}

note bottom of Usuario
  tipo: "ALUNO" | "PROFESSOR" | "ADMIN"
end note

note bottom of Sala
  tipo: "SALA_ESTUDO" | "LABORATORIO"
end note

note bottom of Reserva
  status: "ATIVA" | "CANCELADA"
end note

ReservaController --> ReservaService : "usa"
ReservaService --> ReservaRepository : "usa"
ReservaService --> RegraReserva : "executa"
ReservaService --> RegraAlteracao : "executa"
ReservaService ..> Reserva : "cria / gerencia"

CamposObrigatorios ..|> RegraReserva
HorarioValido ..|> RegraReserva
SalaDeveExistir ..|> RegraReserva
SemConflitoDeHorario ..|> RegraReserva
ApenasDonoOuAdmin ..|> RegraAlteracao

SalaDeveExistir --> SalaRepository : "usa"
SemConflitoDeHorario --> AgendaDeReservas : "usa"

MySqlReservaRepository ..|> ReservaRepository
MySqlReservaRepository ..|> AgendaDeReservas
MySqlSalaRepository ..|> SalaRepository

Reserva --> Usuario : "pertence a (usuarioId)"
Reserva --> Sala : "reserva (salaId)"

@enduml
