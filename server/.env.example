# Copie este arquivo para ".env" e ajuste os valores conforme o seu ambiente.

# Porta em que a API vai rodar
PORT=3001

# Conexão com o MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=catolicareserva

# Segredo usado para assinar os tokens de login (troque por um valor aleatório)
JWT_SECRET=troque-este-segredo
